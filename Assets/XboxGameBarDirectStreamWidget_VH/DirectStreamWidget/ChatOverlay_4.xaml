<Page x:Class="DirectStreamWidget.ChatOverlay"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#CC0F0F0F" RequestedTheme="Dark">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="8" Spacing="8" Background="#22000000">
            <TextBlock Text="💬" FontSize="14"/>
            <TextBlock x:Name="ChatTitle" Text="CHAT OVERLAY" FontWeight="Bold" FontSize="12" Foreground="White"/>
            <TextBlock x:Name="ChatPlatformText" Text="Twitch" Foreground="#AAAAAA" FontSize="11" Margin="8,0,0,0"/>
        </StackPanel>
        
        <!-- WebView for chat - In UWP use WebView, in WinUI3 use WebView2 -->
        <WebView x:Name="ChatWebView" Grid.Row="1" DefaultBackgroundColor="#0F0F0F"/>
        
        <Border Grid.Row="1" x:Name="ChatFallback" Background="#111111" Visibility="Collapsed" Padding="12">
            <StackPanel Spacing="8">
                <TextBlock Text="Chat Preview (WebView requires runtime)" Foreground="#888888" FontSize="11"/>
                <ScrollViewer MaxHeight="400">
                    <StackPanel x:Name="ChatMessages" Spacing="4">
                        <TextBlock Text="🔴 Chat overlay will show here when streaming" Foreground="#555" FontSize="11"/>
                        <TextBlock Text="For Twitch: https://www.twitch.tv/popout/YOUR_CHANNEL/chat" Foreground="#666" FontSize="10"/>
                        <TextBlock Text="For YouTube: Studio -> Live Chat popout" Foreground="#666" FontSize="10"/>
                        <TextBlock Text="For Kick/Rumble: Similar popout URLs" Foreground="#666" FontSize="10"/>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Background="#22000000" Padding="8" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="ChatInput" PlaceholderText="Send message as overlay (requires channel auth)" FontSize="11"/>
            <Button Grid.Column="1" Content="Send" Click="OnSendChat" FontSize="11" Padding="8,4"/>
        </Grid>
    </Grid>
</Page>
