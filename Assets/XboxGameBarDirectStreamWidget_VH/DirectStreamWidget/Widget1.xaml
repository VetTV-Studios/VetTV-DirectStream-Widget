<Page x:Class="DirectStreamWidget.Widget1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#CC1E1E1E" RequestedTheme="Dark">
    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Ellipse Width="10" Height="10" x:Name="StatusLight" Fill="Gray"/>
            <TextBlock Text="DIRECT STREAM" FontWeight="Bold" FontSize="14" Foreground="White"/>
            <TextBlock x:Name="StatusText" Text="Idle" Foreground="#AAAAAA" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- RTMP Inputs -->
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBox x:Name="RtmpUrlBox" PlaceholderText="rtmp://live.twitch.tv/app or rtmp://a.rtmp.youtube.com/live2" Header="RTMP URL" FontSize="12"/>
            <PasswordBox x:Name="StreamKeyBox" PlaceholderText="Stream Key (saved locally)" Header="Stream Key" FontSize="12"/>
        </StackPanel>

        <!-- Options -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="QualityBox" Header="Quality" SelectedIndex="1" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="720p60 - 4500k"/>
                <ComboBoxItem Content="1080p60 - 6000k"/>
                <ComboBoxItem Content="1080p30 - 4500k"/>
                <ComboBoxItem Content="Source - 8000k"/>
            </ComboBox>
            <ComboBox x:Name="EncoderBox" Grid.Column="1" Header="Encoder" SelectedIndex="0">
                <ComboBoxItem Content="Auto (NVENC/QSV/x264)"/>
                <ComboBoxItem Content="NVIDIA NVENC"/>
                <ComboBoxItem Content="Intel QSV"/>
                <ComboBoxItem Content="x264 (CPU)"/>
            </ComboBox>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
            <CheckBox x:Name="DesktopAudioCheck" Content="Desktop Audio" IsChecked="True"/>
            <CheckBox x:Name="MicAudioCheck" Content="Mic" IsChecked="True"/>
            <CheckBox x:Name="MuteMicCheck" Content="Mute Mic" IsChecked="False"/>
        </StackPanel>

        <!-- Main Action -->
        <Button Grid.Row="4" x:Name="StreamButton" Click="OnStreamButtonClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Height="44">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Video" />
                <TextBlock x:Name="StreamButtonText" Text="START STREAMING" FontWeight="SemiBold"/>
            </StackPanel>
        </Button>

        <!-- Log / Stats -->
        <Border Grid.Row="5" Background="#22000000" CornerRadius="4" Padding="8" Margin="0,4,0,0">
            <ScrollViewer>
                <TextBlock x:Name="LogBox" Text="Ready to stream. Enter RTMP details.
Tip: For YouTube, use rtmp://a.rtmp.youtube.com/live2
For Twitch, use rtmp://live.twitch.tv/app" FontFamily="Consolas" FontSize="11" Foreground="#CCCCCC" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatsText" Text="0:00:00 | 0 kbps" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="⚙" Click="OnSettingsClick" Background="Transparent" Foreground="#AAAAAA" Width="32" Height="32"/>
        </Grid>
    </Grid>
</Page>
