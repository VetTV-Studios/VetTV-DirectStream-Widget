<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap4="http://schemas.microsoft.com/appx/manifest/uap/windows10/4"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap4 desktop rescap mp">
  <Identity
    Name="VetTVStudios.DirectStreamWidget"
    Publisher="CN=VetTV Studios"
    Version="1.1.0.0" />
  <mp:PhoneIdentity PhoneProductId="3d7e8a10-5b6c-4d2e-9f10-2a3b4c5d6e7f" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Direct Stream</DisplayName>
    <PublisherDisplayName>VetTV Studios</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.18362.0" MaxVersionTested="10.0.22621.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources>
    <Resource Language="x-generate" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="DirectStreamWidget.App">
      <uap:VisualElements
        DisplayName="Direct Stream"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\SmallLogo.png"
        Description="One-click Go Live from Xbox Game Bar - direct RTMP streaming, no OBS needed."
        BackgroundColor="#0E0520"
        AppListEntry="none">
        <uap:DefaultTile Wide310x150Logo="Assets\WideTile.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0E0520" />
      </uap:VisualElements>
      <Extensions>
        <!-- Game Bar widget registration. The widget definition IDs below must
             match the strings handled in App.xaml.cs OnActivated. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="microsoft.gameBarUIExtension"
            Id="com.vettv.directstream"
            DisplayName="Direct Stream"
            Description="Direct RTMP streaming widget for Xbox Game Bar"
            PublicFolder="GameBar">
            <uap3:Properties>
              <GameBarWidget Type="Standard">
                <Size Height="520" Width="420">
                  <Height Min="360" Max="900" />
                  <Width Min="360" Max="640" />
                </Size>
                <HomeMenuVisible>true</HomeMenuVisible>
                <PinningSupported>true</PinningSupported>
                <SettingsSupported>true</SettingsSupported>
                <GameBarWidgetDefinition Id="DirectStreamMain" DisplayName="DIRECT STREAM" />
                <GameBarWidgetSettings SettingsId="DirectStreamSettings" />
                <GameBarWidgetDefinition Id="DirectStreamSettings" DisplayName="DIRECT STREAM SETTINGS" />
              </GameBarWidget>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
        <!-- App service hosted by the widget process (see App.OnBackgroundActivated).
             The full-trust StreamerHost connects to this service as a client. -->
        <uap:Extension Category="windows.appService" EntryPoint="DirectStreamWidget.App">
          <uap3:AppService Name="DirectStreamService" />
        </uap:Extension>
        <!-- Full-trust companion process: runs ffmpeg (NVENC/QSV/x264) and pushes RTMP.
             Launched from the widget via FullTrustProcessLauncher. -->
        <desktop:Extension Category="windows.fullTrustProcess" Executable="StreamerHost\StreamerHost.exe">
          <desktop:FullTrustProcess>
            <desktop:ParameterGroup GroupId="User" Parameters="" />
          </desktop:FullTrustProcess>
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Extensions>
    <!-- Proxy/stub registration for the Xbox Game Bar SDK.
         NOTE: the Microsoft.Gaming.XboxGameBar NuGet package generates this
         proxy/stub registration at build time in current SDK versions. If the
         widget does not appear in Game Bar after deploy, compare this section
         against the official Xbox Game Bar widget sample for SDK 7.3.x and add
         the sample's <Interface> entries verbatim - do not invent InterfaceIds. -->
    <Extension Category="windows.activatableClass.proxyStub">
      <ProxyStub ClassId="00000355-0000-0000-C000-000000000046">
        <Path>Microsoft.Gaming.XboxGameBar.winmd</Path>
      </ProxyStub>
    </Extension>
  </Extensions>
  <Capabilities>
    <Capability Name="internetClient" />
    <uap:Capability Name="microphone" />
    <uap:Capability Name="appDiagnostics" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
