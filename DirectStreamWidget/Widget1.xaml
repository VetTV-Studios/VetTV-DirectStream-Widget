<Page
    x:Class="DirectStreamWidget.Widget1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    Background="#0E0520">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / status -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusLight" Grid.Column="0" Width="12" Height="12"
                     Fill="Gray" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center">
                <Run Text="DIRECT STREAM" FontWeight="Bold" Foreground="#00D9FF" />
                <Run Text="  -  " Foreground="Gray" />
                <Run x:Name="StatusText" Text="Idle" Foreground="White" />
            </TextBlock>
            <Button Grid.Column="2" Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                    Click="OnSettingsClick" Background="Transparent" Foreground="White"
                    AutomationProperties.Name="Settings" />
        </Grid>

        <!-- Platform + destination -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12">
            <ComboBox x:Name="PlatformBox" Header="Platform" HorizontalAlignment="Stretch"
                      SelectionChanged="OnPlatformChanged" />
            <TextBox x:Name="RtmpUrlBox" Header="RTMP URL" PlaceholderText="rtmp://ingest.vettv.com/live" />
            <PasswordBox x:Name="StreamKeyBox" Header="Stream key" />
        </StackPanel>

        <!-- Quality + encoder -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,12">
            <ComboBox x:Name="QualityBox" Header="Quality" HorizontalAlignment="Stretch" SelectedIndex="1">
                <ComboBoxItem Content="720p60 - 4500k" />
                <ComboBoxItem Content="720p30 - 3000k" />
                <ComboBoxItem Content="1080p60 - 6000k" />
                <ComboBoxItem Content="1080p30 - 4500k" />
                <ComboBoxItem Content="1440p60 - 9000k" />
                <ComboBoxItem Content="1440p30 - 7000k" />
            </ComboBox>
            <ComboBox x:Name="EncoderBox" Header="Encoder" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem Content="Auto (NVENC/QSV/AMF/x264)" />
                <ComboBoxItem Content="NVIDIA NVENC" />
                <ComboBoxItem Content="Intel QSV" />
<ComboBoxItem Content="AMD AMF" />
                <ComboBoxItem Content="x264 (CPU)" />
            </ComboBox>
        </StackPanel>

        <!-- Audio -->
        <StackPanel Grid.Row="3" Spacing="4" Margin="0,0,0,12">
            <CheckBox x:Name="DesktopAudioCheck" Content="Desktop / game audio" IsChecked="True" Foreground="White" />
            <CheckBox x:Name="MicAudioCheck" Content="Microphone" IsChecked="True" Foreground="White" />
            <CheckBox x:Name="MuteMicCheck" Content="Mute mic" IsChecked="False" Foreground="White" />
        </StackPanel>

        <Button x:Name="StreamButton" Grid.Row="4" Content="START STREAMING"
                Style="{StaticResource PrimaryButton}" Click="OnStreamButtonClick" Margin="0,0,0,12" />

        <TextBlock x:Name="StatsText" Grid.Row="5" Text="" Foreground="Gray" Margin="0,0,0,8" />

        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="LOG - copy these messages if Start fails"
                           VerticalAlignment="Center" Foreground="#B8B8D0" FontSize="11" />
                <Button Grid.Column="1" Content="Copy log" Click="OnCopyLogClick"
                        Padding="8,2" />
            </Grid>
            <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                     Background="#140A2E" Foreground="#B8B8D0"
                     AutomationProperties.Name="Streaming diagnostics log" />
        </Grid>
    </Grid>
</Page>
