<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>StreamerHost</AssemblyName>
    <RootNamespace>StreamerHost</RootNamespace>
    <!-- The host is launched by the widget package as a full-trust process;
         it must be a framework-dependent exe the package can carry. -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
</Project>
