<Window x:Class="VetTVDirectStream.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VetTV DirectStream" Width="520" Height="720" Background="#101418" Foreground="White"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#C8D0D8"/><Setter Property="Margin" Value="0,10,0,3"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <TextBlock Text="VetTV DirectStream" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0"/>
      <TextBlock Name="StatusText" Text="Ready" FontSize="13"/>

      <TextBlock Text="Platform"/>
      <ComboBox Name="PlatformBox" SelectionChanged="PlatformBox_Changed"/>
      <TextBlock Text="Server URL (RTMP/RTMPS)"/>
      <TextBox Name="ServerBox"/>
      <TextBlock Text="Stream key (stored encrypted for your Windows account)"/>
      <PasswordBox Name="KeyBox"/>

      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Resolution"/><ComboBox Name="ResBox"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Frame rate"/><ComboBox Name="FpsBox"/></StackPanel>
      </Grid>
      <TextBlock Text="Video bitrate kbps (0 = automatic)"/>
      <TextBox Name="BitrateBox" Text="0"/>
      <TextBlock Text="Encoder"/>
      <ComboBox Name="EncBox"/>

      <TextBlock Text="Audio mixer" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,18,0,0"/>
      <CheckBox Name="GameOn" Content="Game / desktop audio" IsChecked="True" Margin="0,8,0,0" Click="Mixer_Changed"/>
      <Slider Name="GameVol" Minimum="0" Maximum="1" Value="0.8" ValueChanged="Mixer_Slider"/>
      <ProgressBar Name="GameMeter" Height="6" Maximum="1"/>
      <CheckBox Name="MicOn" Content="Microphone" IsChecked="True" Margin="0,12,0,0" Click="Mixer_Changed"/>
      <ComboBox Name="MicBox" DisplayMemberPath="Name" Margin="0,4,0,0"/>
      <Slider Name="MicVol" Minimum="0" Maximum="1" Value="0.8" ValueChanged="Mixer_Slider"/>
      <ProgressBar Name="MicMeter" Height="6" Maximum="1"/>

      <Button Name="GoBtn" Content="Go Live" Height="46" FontSize="16" FontWeight="Bold" Margin="0,22,0,0" Click="GoBtn_Click"
              Background="#C0392B" Foreground="White"/>
      <TextBlock Name="StatsText" Text="" FontFamily="Consolas"/>
      <TextBox Name="LogBox" Height="140" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               Background="#0A0D10" Foreground="#8FA3B5" FontFamily="Consolas" FontSize="11"/>
    </StackPanel>
  </ScrollViewer>
</Window>
