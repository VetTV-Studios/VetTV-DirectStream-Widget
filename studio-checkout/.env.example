# Test / sandbox keys only while developing.
# Prefer a restricted key (rk_ / rkcs_) over a secret key (sk_).
STRIPE_SECRET_KEY=rk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price ID from `npm run create-product` (or Dashboard → Products)
STRIPE_PRICE_ID=price_...

# Local app URL (must match Checkout success/cancel redirects)
DOMAIN=http://localhost:4242

# From `stripe listen --forward-to localhost:4242/webhook` (or Dashboard webhook endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...
