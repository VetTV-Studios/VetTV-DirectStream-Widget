{
  "name": "vettv-studio-checkout",
  "version": "1.0.0",
  "private": true,
  "description": "VetTV Studios Stripe-hosted Checkout for one-time digital product payments",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "create-product": "node scripts/create-product.js",
